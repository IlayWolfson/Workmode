{
  "manifest_version": 3,
  "name": "Workmode",
  "version": "1.2.2",
  "description": "Keeps only the allowed sites open during a Workmode session.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "minimum_chrome_version": "110",
  "permissions": ["tabs", "webNavigation", "alarms", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "https://www.youtube.com/*"],
  "background": { "service_worker": "background.js", "type": "module" }
}
